# Purpose: SAME alert decoder pipeline (rtl_fm | multimon-ng | curl).
#          Streams EAS headers to rpi-pod-listen via /alerts/internal so
#          the landing page can pin a red banner when one fires.
# Unit:    rpi-pod-listen-same.service
# Phase:   8 (sub-phase 8.2)
#
# The pipeline holds the dongle whenever it is active. rpi-pod-listen's
# /tune endpoint stops this unit on a user tune request and brings it
# back when the user stops tuning.
#
# Mutually exclusive with dump1090-mutability — a single RTL-SDR dongle
# is claimed by whichever service starts first. See docs/OVERVIEW.md §7.4.

[Unit]
Description=rpi-POD SAME alert decoder pipeline (rtl_fm + multimon-ng)
After=network.target rpi-pod-listen.service rpi-pod-ap.service
PartOf=rpi-pod-listen.service
ConditionPathExists=/usr/bin/rtl_fm
ConditionPathExists=/usr/bin/multimon-ng

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=plugdev

# /opt/rpi-pod/scripts/same_pipeline.sh chains rtl_fm | multimon-ng |
# curl. The "exec" wrapper makes systemd track the rtl_fm pid for the
# cgroup lifetime even though the shell forks.
ExecStart=/opt/rpi-pod/scripts/same_pipeline.sh

Environment=RPI_POD_SAME_FREQ_HZ=162400000
Environment=RPI_POD_LISTEN_URL=http://127.0.0.1:8300

Restart=on-failure
RestartSec=10
TimeoutStopSec=10

# rtl_fm + multimon-ng cap. 128M is enough; bumping this means a real
# leak somewhere.
MemoryMax=128M
TasksMax=64

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=no
DeviceAllow=char-usb_device rw
ReadOnlyPaths=/opt/rpi-pod /var/lib/rpi-pod/listen

[Install]
WantedBy=multi-user.target
