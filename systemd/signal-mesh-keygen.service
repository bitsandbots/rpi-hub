# Purpose: One-shot keypair provisioning. Runs once at boot to make sure
#          /var/lib/signal/keys/ed25519.{priv,pub} exist before
#          signal-mesh.service starts. Splitting this out of
#          signal-mesh.service lets the long-running daemon drop
#          filesystem access to the key directory entirely — it picks
#          up the private bytes via LoadCredential= instead.
# Unit:    signal-mesh-keygen.service
# Phase:   7 (introduced v1.2)
#
# Why a separate unit: LoadCredential= requires its source file to
# already exist at unit-start, and we still want first-boot to "just
# work" without an out-of-band provisioning step. Keygen is a oneshot
# with RemainAfterExit=yes so it can sequence ahead of the daemon and
# the credential loader sees a populated key dir on every boot.

[Unit]
Description=SIGNAL mesh Ed25519 keypair provisioning (oneshot)
After=local-fs.target
Before=signal-mesh.service
PartOf=signal-mesh.service

[Service]
Type=oneshot
RemainAfterExit=yes
DynamicUser=yes

# Owns the key directory. signal-mesh.service no longer mounts this
# path (LoadCredential reads it as root before stepping down to the
# daemon's dynamic user), so the dynamic UID mismatch is intentional.
StateDirectory=signal/keys
StateDirectoryMode=0700

Environment=PYTHONPATH=/opt/signal
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/signal

# Generates priv/pub if either is missing. Idempotent: a second run
# with both files in place is a no-op.
ExecStart=/usr/bin/python3 -c "from mesh.signal_mesh import identity; identity.load_or_create()"

# Tight sandbox — the only thing we touch is the key directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/opt/signal

[Install]
WantedBy=multi-user.target
