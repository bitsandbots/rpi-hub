# Purpose: Run the FastAPI rpi-hub-assist app on 127.0.0.1:8200. nginx
#          (Phase 6) proxies /api/ask to this upstream. The service wraps
#          retrieval with the safety classifier, prompt scaffold, and a
#          llama.cpp HTTP client. It is the "Ask" tile's backend.
# Unit:    rpi-hub-assist.service
# Phase:   6
#
# Dependency chain:
#   rpi-hub-llama.service     (the model server; ships separately, fetch_models.sh)
#   rpi-hub-retrieve.service  (hybrid retrieval)
#   rpi-hub-assist.service    (this — composes the other two)
#
# Stays inactive when no Qwen weights are present.

[Unit]
Description=rpi-hub retrieval-grounded answer API (FastAPI)
After=network.target rpi-hub-retrieve.service rpi-hub-llama.service
Wants=rpi-hub-retrieve.service rpi-hub-llama.service
PartOf=rpi-hub-ap.service
ConditionPathExists=/var/lib/rpi-hub/models/qwen2.5-1.5b-instruct-q4_k_m.gguf

[Service]
Type=simple
DynamicUser=yes

Environment=PYTHONPATH=/opt/rpi-hub
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/rpi-hub

ExecStart=/usr/bin/python3 -m uvicorn assistant.rpi_hub_assist.main:app \
    --host 127.0.0.1 \
    --port 8200 \
    --log-level warning \
    --no-access-log

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Stays light: this service shells the heavy lifting to rpi-hub-llama.
MemoryMax=192M
TasksMax=64

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/rpi-hub /opt/rpi-hub

[Install]
WantedBy=multi-user.target
