# Purpose: Run the FastAPI rpi-pod-status app on 127.0.0.1:8000. nginx
#          (Phase 4) proxies /api/ to this upstream. The endpoint is the
#          backing data source for /status.html and a sanity hook for
#          healthcheck.sh.
# Unit:    rpi-pod-status.service
# Phase:   5

[Unit]
Description=rpi-POD status API (FastAPI)
After=network.target rpi-pod-ap.service
PartOf=rpi-pod-ap.service

[Service]
Type=simple
DynamicUser=yes
# vcgencmd reads /dev/vcio, which is root:video 0660 on Raspberry Pi OS.
# DynamicUser creates a fresh user with no groups; SupplementaryGroups
# adds it to video so the voltage probe works. On non-Pi hosts the group
# may not exist — systemd downgrades to a warning, the probe falls back
# to "unknown", and the service still starts.
SupplementaryGroups=video

# The package is deployed under /opt/rpi-pod/api/ by install.sh. PYTHONPATH
# scoped to the unit avoids polluting the global interpreter path.
Environment=PYTHONPATH=/opt/rpi-pod/api
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/rpi-pod/api

ExecStart=/usr/bin/python3 -m uvicorn rpi_pod_status.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level warning \
    --no-access-log

Restart=on-failure
RestartSec=3
# uvicorn handles SIGTERM cleanly; give it a few seconds to drain.
TimeoutStopSec=10

# Resource ceiling. The app is tiny (Python interpreter + FastAPI + a few
# probes); 128M is generous. If we ever blow past this it's a bug worth
# catching.
MemoryMax=128M
TasksMax=64

# Hardening. The probes are all read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Network: AF_INET for the uvicorn listener; AF_UNIX for stdlib internals.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/kiwix /var/lib/misc /etc/rpi-pod /opt/rpi-pod

[Install]
WantedBy=multi-user.target
