# Purpose: Run the FastAPI rpi-hub-retrieve app on 127.0.0.1:8100. nginx
#          (Phase 6) proxies /api/retrieve to this upstream. The endpoint
#          backs both the Ask UI and any third-party tooling that wants
#          plain hybrid retrieval against the local library.
# Unit:    rpi-hub-retrieve.service
# Phase:   6
#
# Notes:
#   - ConditionPathExists guards on /var/lib/rpi-hub/index/chunks.sqlite,
#     so a node without a prebuilt index stays inactive instead of
#     crash-looping. The Ask tile self-disables when this unit is down.
#   - The service holds an HNSW handle in RAM (~150 MB for a Wikipedia
#     no-images corpus). MemoryMax is the early-warning ceiling.

[Unit]
Description=rpi-hub hybrid retrieval API (FastAPI)
After=network.target rpi-hub-ap.service
PartOf=rpi-hub-ap.service
ConditionPathExists=/var/lib/rpi-hub/index/chunks.sqlite

[Service]
Type=simple
DynamicUser=yes

Environment=PYTHONPATH=/opt/rpi-hub
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/rpi-hub

ExecStart=/usr/bin/python3 -m uvicorn assistant.rpi_hub_retrieve.main:app \
    --host 127.0.0.1 \
    --port 8100 \
    --log-level warning \
    --no-access-log

Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# HNSW + sqlite cache. Generous on a Pi 5 (8 GB); will need tuning on
# 4 GB Pi 4 builds.
MemoryMax=512M
TasksMax=128

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no  # llama.cpp / numpy may JIT-emit pages
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/var/lib/rpi-hub /opt/rpi-hub

[Install]
WantedBy=multi-user.target
