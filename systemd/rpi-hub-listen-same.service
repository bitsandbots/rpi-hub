# Purpose: SAME alert decoder pipeline (rtl_fm | multimon-ng | curl).
#          Streams EAS headers to rpi-hub-listen via /alerts/internal so
#          the landing page can pin a red banner when one fires.
# Unit:    rpi-hub-listen-same.service
# Phase:   8 (sub-phase 8.2)
#
# The pipeline holds the shared RTL-SDR flock (/run/rpi-hub/rtlsdr.lock)
# for its whole lifetime, so the in-process Tuner (FM/GPS) and
# dump1090-mutability are locked out while SAME is active. A user /tune
# request that finds the dongle held returns 409 (TunerBusy); the
# operator stops this unit to free the radio. There is no longer any
# implicit stop/restart of this unit from the /tune endpoint — the
# DynamicUser sandbox cannot manage sibling units, so coordination is via
# the flock, not systemctl.
#
# Mutually exclusive with dump1090-mutability — a single RTL-SDR dongle
# is claimed by whichever service holds the flock first. See
# docs/OVERVIEW.md §7.4.

[Unit]
Description=rpi-hub SAME alert decoder pipeline (rtl_fm + multimon-ng)
After=network.target rpi-hub-listen.service rpi-hub-ap.service
PartOf=rpi-hub-listen.service
ConditionPathExists=/usr/bin/rtl_fm
ConditionPathExists=/usr/bin/multimon-ng
# Cap restart storms: if rtl_fm keeps exiting (e.g. a flapping dongle),
# stop retrying after 5 failures in 5 minutes instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=plugdev

# Hardware gate: skip cleanly (condition-failed, not crash-looped) when no
# RTL-SDR dongle is plugged in. The decoder *binaries* are installed
# unconditionally, so a binary-only ConditionPathExists is not enough —
# without this the pipeline's rtl_fm would exit non-zero every 10s.
ExecCondition=/opt/rpi-hub/scripts/detect_rtlsdr.sh

# /opt/rpi-hub/scripts/same_pipeline.sh chains rtl_fm | multimon-ng |
# curl. The "exec" wrapper makes systemd track the rtl_fm pid for the
# cgroup lifetime even though the shell forks.
ExecStart=/opt/rpi-hub/scripts/same_pipeline.sh

Environment=rpi_hub_SAME_FREQ_HZ=162400000
Environment=rpi_hub_LISTEN_URL=http://127.0.0.1:8300

Restart=on-failure
RestartSec=10
TimeoutStopSec=10

# rtl_fm + multimon-ng cap. 128M is enough; bumping this means a real
# leak somewhere.
MemoryMax=128M
TasksMax=64

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=no
DeviceAllow=char-usb_device rw
ReadOnlyPaths=/opt/rpi-hub /var/lib/rpi-hub/listen

[Install]
WantedBy=multi-user.target
